#!/bin/sh
# PBR include for user-maintained domain and IPv4 network lists.

TARGET_INTERFACE='awg0'
TARGET_NFTSET_4="pbr_${TARGET_INTERFACE}_4_dst_ip_user"
TARGET_TABLE='inet fw4'
DOMAIN_FILE='/etc/pbr/vpn-domains.txt'
NETWORK_FILE='/etc/pbr/vpn-networks.txt'
DNSMASQ_FILE="${packageDnsmasqFile:-/var/run/pbr.dnsmasq}"
CHUNK_SIZE=200

if [ -s "$DOMAIN_FILE" ]; then
    touch "$DNSMASQ_FILE" || return 1

    awk -v target="4#inet#fw4#$TARGET_NFTSET_4" -v chunk="$CHUNK_SIZE" '
    function flush_line() {
        if (n > 0) {
            print "nftset=" domains "/" target
            domains=""
            n=0
        }
    }
    NF {
        if (n == 0) domains="/" $0
        else domains=domains "/" $0
        n++
        if (n >= chunk) flush_line()
    }
    END { flush_line() }
    ' "$DOMAIN_FILE" >> "$DNSMASQ_FILE" || return 1
fi

if [ -s "$NETWORK_FILE" ]; then
    nft list set $TARGET_TABLE "$TARGET_NFTSET_4" >/dev/null 2>&1 || return 1

    NFT_BATCH="$(mktemp /tmp/pbr-openwrt-lists.XXXXXX)" || return 1

    awk -v set="$TARGET_NFTSET_4" -v chunk="$CHUNK_SIZE" '
    function flush_line() {
        if (n > 0) {
            print "add element inet fw4 " set " { " elems " }"
            elems=""
            n=0
        }
    }
    NF {
        if (n == 0) elems=$0
        else elems=elems ", " $0
        n++
        if (n >= chunk) flush_line()
    }
    END { flush_line() }
    ' "$NETWORK_FILE" > "$NFT_BATCH" || {
        rm -f "$NFT_BATCH"
        return 1
    }

    nft -f "$NFT_BATCH" || {
        rm -f "$NFT_BATCH"
        return 1
    }

    rm -f "$NFT_BATCH"
fi

return 0
